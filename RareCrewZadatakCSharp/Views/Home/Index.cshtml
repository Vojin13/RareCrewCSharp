@using RareCrewZadatakCSharp.ViewModels
@model EmployeeTableViewModel

@{
    ViewData["Title"] = "Employee Worked Time";
}

<h1 class="mb-4">Total time worked per employee</h1>

@if (Model.HasError)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Total time worked (h)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr class="@(employee.TotalTime.TotalHours < EmployeeTableViewModel.LowHoursThreshold ? "table-danger" : "")">
                    <td>@employee.Name</td>
                    <td>@employee.TotalTime.TotalHours.ToString("F1")</td>
                </tr>
            }
        </tbody>
    </table>

    <img src="@Url.Action("Chart", "Home")" alt="Time worked per employee" />
}
